# Copy to .env. Never commit real credentials.
OPENAI_API_KEY=sk-your-api-key
# Affordable writer and independent visual/factual reviewer.
OPENAI_MODEL=gpt-5-mini
OPENAI_REVIEW_MODEL=gpt-5-mini
MAX_CANDIDATES_PER_RUN=6
MAX_POSTS_PER_RUN=5
MIN_SOURCE_WORDS=80
MIN_ARTICLE_WORDS=150
MIN_QUALITY_SCORE=90

WORDPRESS_BASE_URL=https://alcornnewsms.com
WORDPRESS_USERNAME=your-username
WORDPRESS_APP_PASSWORD=your-application-password
WORDPRESS_POST_STATUS=publish
WORDPRESS_AUTHOR_ID=1
WORDPRESS_AUTHOR_NAME=Jon R Myers

TIMEZONE=America/Chicago
LOG_LEVEL=INFO
LOG_FILE=
# Optional: leave empty to require original source images for every article.
# Used only after a strict stock-appropriateness and visual relevance review.
PEXELS_API_KEY=
